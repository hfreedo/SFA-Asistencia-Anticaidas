# Copy to .env next to the source root or portable EXE. Never publish .env.
# HTTPS certificates must be trusted by the phone, and cover the LAN IP/hostname.
SFA_TLS_CERT=certs/sfa.pem
SFA_TLS_KEY=certs/sfa-key.pem

# Optional email alerts. Use an SMTP account/password authorized by your provider.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. No unencrypted mode.
SFA_SMTP_HOST=
SFA_SMTP_PORT=587
SFA_SMTP_USER=
SFA_SMTP_PASSWORD=
SFA_SMTP_FROM=
# Comma-separated recipients. No Telegram installation is required.
SFA_SMTP_TO=
